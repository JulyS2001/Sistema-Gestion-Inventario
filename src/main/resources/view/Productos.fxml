<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventarioropa.controller.ProductosController">

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="25"
                        right="28"
                        bottom="25"
                        left="28"/>
            </padding>


            <!-- BUSCADOR -->

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <TextField fx:id="txtBuscar"
                           promptText="Buscar por nombre, talle o color..."
                           prefWidth="400"
                           styleClass="search-field"/>

                <Button text="+ Nuevo producto"
                        onAction="#abrirNuevoProducto"
                        styleClass="btn-primary"/>

            </HBox>


            <!-- TABLA -->

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Productos registrados"
                       styleClass="section-title"/>


                <TableView fx:id="tablaProductos"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="60"/>

                        <TableColumn fx:id="colNombre"
                                     text="Producto"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colTalle"
                                     text="Talle"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colColor"
                                     text="Color"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colPrecio"
                                     text="Precio"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colStock"
                                     text="Stock"
                                     prefWidth="100"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- ACCIONES -->

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Button text="Editar"
                        onAction="#editarProducto"
                        styleClass="btn-edit"/>

                <Button text="Eliminar"
                        onAction="#eliminarProducto"
                        styleClass="btn-delete"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>