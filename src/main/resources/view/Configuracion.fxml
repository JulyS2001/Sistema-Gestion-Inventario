<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.inventarioropa.controller.ConfiguracionController">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <VBox spacing="10"
          styleClass="dashboard-card">

        <Label text="Base de datos"
               styleClass="section-title"/>

        <Label text="Ubicación de la base de datos"/>

        <Label fx:id="lblRutaBaseDatos"
               wrapText="true"/>

    </VBox>

    <VBox spacing="15"
          styleClass="dashboard-card">

        <Label text="Copias de seguridad"
               styleClass="section-title"/>

        <Label text="Realizá copias de seguridad para proteger la información del inventario."/>

        <HBox spacing="10">

            <Button text="Crear backup"
                    styleClass="btn-primary"
                    onAction="#crearBackup"/>

            <Button text="Abrir carpeta de backups"
                    styleClass="btn-primary"
                    onAction="#abrirCarpetaBackups"/>

        </HBox>

    </VBox>

</VBox>