<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inventarioropa.controller.NuevaVentaController"
      spacing="18">

    <padding>
        <Insets top="5"
                right="5"
                bottom="5"
                left="5"/>
    </padding>


    <!-- AGREGAR PRODUCTO -->

    <VBox spacing="12"
          styleClass="sale-product-form">

        <Label text="Nueva venta"
               styleClass="section-title"/>

        <GridPane hgap="15"
                  vgap="10">

            <Label text="Producto"
                   styleClass="form-label"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <ComboBox fx:id="cmbProducto"
                      promptText="Seleccionar producto"
                      maxWidth="Infinity"
                      GridPane.rowIndex="0"
                      GridPane.columnIndex="1"
                      styleClass="form-field"/>

            <Label text="Cantidad"
                   styleClass="form-label"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="txtCantidad"
                       promptText="Ingresar cantidad"
                       maxWidth="Infinity"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"
                       styleClass="form-field"/>

        </GridPane>

        <HBox alignment="CENTER_RIGHT">

            <Button fx:id="btnAgregar"
                    text="+ Agregar producto"
                    onAction="#agregarProducto"
                    styleClass="btn-primary"/>

        </HBox>

    </VBox>


    <!-- TABLA -->

    <VBox spacing="10"
          VBox.vgrow="ALWAYS">

        <Label text="Productos de la venta"
               styleClass="section-title"/>

        <TableView fx:id="tablaDetalles"
                   styleClass="sale-table"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colProducto"
                             text="Producto"
                             prefWidth="250"/>

                <TableColumn fx:id="colCantidad"
                             text="Cantidad"
                             prefWidth="100"/>

                <TableColumn fx:id="colPrecio"
                             text="Precio unitario"
                             prefWidth="130"/>

                <TableColumn fx:id="colSubtotal"
                             text="Subtotal"
                             prefWidth="130"/>

            </columns>

        </TableView>

    </VBox>


    <!-- TOTAL -->

    <HBox alignment="CENTER_RIGHT"
          spacing="20"
          styleClass="total-container">

        <Label text="TOTAL"
               styleClass="section-title"/>

        <Label fx:id="lblTotal"
               text="0"
               styleClass="total-label"/>

    </HBox>


    <!-- ACCIONES -->

    <HBox alignment="CENTER_RIGHT"
          spacing="10">

        <Button fx:id="btnQuitar"
                text="Quitar producto"
                onAction="#quitarProducto"
                styleClass="btn-delete"/>

        <Button fx:id="btnRegistrar"
                text="Registrar venta"
                onAction="#registrarVenta"
                styleClass="btn-primary"/>

    </HBox>

</VBox>