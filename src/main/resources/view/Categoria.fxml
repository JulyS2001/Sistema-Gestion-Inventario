<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventarioropa.controller.CategoriaController">


    <!-- ============================= -->
    <!-- CONTENIDO -->
    <!-- ============================= -->

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="25"
                        right="28"
                        bottom="20"
                        left="28"/>
            </padding>


            <!-- NUEVA CATEGORÍA -->

            <VBox spacing="8">

                <Label text="Nueva categoría"
                       styleClass="section-title"/>

                <HBox spacing="10">

                    <TextField fx:id="txtNombre"
                               promptText="Ej: Remeras"
                               prefWidth="300"
                               styleClass="category-field"/>

                    <Button text="+ Agregar"
                            fx:id="btnAgregar"
                            onAction="#agregarCategoria"
                            styleClass="btn-primary"/>

                </HBox>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="8"
                  VBox.vgrow="ALWAYS">

                <Label text="Categorías registradas"
                       styleClass="section-title"/>

                <TableView fx:id="tablaCategorias"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="80"/>

                        <TableColumn fx:id="colNombre"
                                     text="Categoría"
                                     prefWidth="300"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>


    <!-- ============================= -->
    <!-- BOTONES INFERIORES -->
    <!-- ============================= -->

    <bottom>

        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              styleClass="bottom-bar">

            <Button text="Editar"
                    fx:id="btnEditar"
                    onAction="#editarCategoria"
                    styleClass="btn-edit"/>

            <Button text="Eliminar"
                    fx:id="btnEliminar"
                    onAction="#eliminarCategoria"
                    styleClass="btn-delete"/>

        </HBox>

    </bottom>

</BorderPane>