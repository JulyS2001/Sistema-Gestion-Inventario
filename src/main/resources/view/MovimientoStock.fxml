<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventarioropa.controller.MovimientoStockController">


    <!-- ============================= -->
    <!-- CONTENIDO -->
    <!-- ============================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="25"
                        right="28"
                        bottom="20"
                        left="28"/>
            </padding>


            <!-- ========================= -->
            <!-- FORMULARIO -->
            <!-- ========================= -->

            <VBox spacing="12"
                  styleClass="movement-form">

                <Label text="Registrar movimiento"
                       styleClass="section-title"/>


                <GridPane hgap="15"
                          vgap="10">

                    <!-- PRODUCTO -->

                    <Label text="Producto"
                           styleClass="form-label"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="cmbProducto"
                              promptText="Seleccionar producto"
                              maxWidth="Infinity"
                              GridPane.rowIndex="0"
                              GridPane.columnIndex="1"
                              styleClass="form-field"/>


                    <!-- TIPO -->

                    <Label text="Tipo"
                           styleClass="form-label"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="cmbTipo"
                              promptText="Tipo de movimiento"
                              maxWidth="Infinity"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"
                              styleClass="form-field"/>


                    <!-- CANTIDAD -->

                    <Label text="Cantidad"
                           styleClass="form-label"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtCantidad"
                               promptText="Ingresar cantidad"
                               maxWidth="Infinity"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"
                               styleClass="form-field"/>


                    <!-- MOTIVO -->

                    <Label text="Motivo"
                           styleClass="form-label"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="cmbMotivo"
                              promptText="Seleccionar motivo"
                              maxWidth="Infinity"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"
                              styleClass="form-field"/>

                </GridPane>


                <!-- BOTÓN -->

                <HBox alignment="CENTER_RIGHT">

                    <Button text="Registrar movimiento"
                            fx:id="btnRegistrar"
                            onAction="#registrarMovimiento"
                            styleClass="btn-primary"/>

                </HBox>

            </VBox>


            <!-- ========================= -->
            <!-- HISTORIAL -->
            <!-- ========================= -->

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <Label text="Historial de movimientos"
                       styleClass="section-title"/>


                <TableView fx:id="tablaMovimientos"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colFecha"
                                     text="Fecha"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colProducto"
                                     text="Producto"
                                     prefWidth="170"/>

                        <TableColumn fx:id="colTipo"
                                     text="Tipo"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colAnterior"
                                     text="Stock anterior"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colCantidad"
                                     text="Cantidad"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colResultante"
                                     text="Stock resultante"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colMotivo"
                                     text="Motivo"
                                     prefWidth="190"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>